# CMC Dashboard RAG — copy to .env and replace placeholders.
# Location: cmc-dashboard/backend/.env.example

# --- Chat / generation: Bayer myGenAssist ---
LLM_PROVIDER=mga
MGA_API_KEY=REPLACE_WITH_YOUR_MGA_API_KEY
MGA_BASE_URL=REPLACE_WITH_MGA_BASE_URL
MGA_MODEL=gpt-4o
MGA_API_VERSION=
MGA_AUTH_HEADER=Authorization

# --- Embeddings: local on-device by default ---
EMBED_PROVIDER=local
MGA_EMBED_MODEL=text-embedding-3-small

# --- Access control ---
APP_USERNAME=cmc
APP_PASSWORD=REPLACE_WITH_SHARED_PASSWORD

# --- Public OpenAI fallback (unused with MGA) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Optional overrides ---
# QNA_PATH=
# CHROMA_DIR=
# CHROMA_COLLECTION=cmc_qna
# RETRIEVE_TOP_K=5
# MIN_RELEVANCE=0.25
